# --- Supabase ---
# Project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (server-only, NEVER expose to the client) — Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
# API key from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- Slack ---
# Two modes — pick one:
#
# Mode 1 (preferred): Bot Token — gives you interactive Approve/Reject buttons
#   in Slack, no need to click through to the web UI. Requires:
SLACK_BOT_TOKEN=             # xoxb-... from OAuth & Permissions → Bot User OAuth Token
SLACK_SIGNING_SECRET=        # Basic Information → App Credentials → Signing Secret
SLACK_CHANNEL_ID=            # e.g. C0B1DTXL2FN — channel where approval pings land
#
# Mode 2 (fallback): Incoming webhook — plain text message + link to web UI
SLACK_WEBHOOK_URL=           # https://hooks.slack.com/services/...

# --- Stripe ---
# Use a test-mode key for the demo (sk_test_...) — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=

# --- Resend (customer email) ---
# API key from resend.com → API Keys (re_...). If unset, the customer email
# step is mocked (logs payload to proposal_events instead of sending).
RESEND_API_KEY=

# --- App ---
# Public URL of the deployment (used in Slack approval links + Stripe redirect)
# Local dev: http://localhost:3000
# Vercel: https://<your-app>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
